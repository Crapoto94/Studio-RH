generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model BrutRh {
  id                Int     @id @default(autoincrement())
  MATRICULE         String?
  NOM               String?
  PRENOM            String?
  STATUT            String?
  STATUT_L          String?
  DIRECTION         String?
  DIRECTION_L       String?
  SERVICE           String?
  SERVICE_L         String?
  PST_AFFECT        String?
  PST_AFFECT_L      String?
  AFFECT            String?
  AFFECT_L          String?
  POSTE             String?
  POSTE_L           String?
  FONCTION          String?
  FONCTION_L        String?
  AFFECTGEO         String?
  AFFECTGEO_L       String?
  AGT_GRADE         String?
  AGT_GRADE_L       String?
  PST_CADREMP       String?
  PST_CADREMP_L     String?
  PST_CAT           String?
  DATE_ARRIVEE      String?
  MOTIF_ARRIVEE     String?
  DATE_DEPART       String?
  MOTIF_DEPART      String?
  DATE_MODIF_DOSS   String?
  DATE_EXTRACT_DOSS String?
  DATE_MAJ          String?
  COLLECTIVITE      String?
  COLLECTIVITE_L    String?
  POSITION          String?
  POSITION_L        String?
  FIN_PREV_POS      String?
  CIVILITE          String?
  EMAIL_PERSO       String?
  EMAIL_PRO         String?
  TELEPHONE_PRO     String?
  MOBILE_PRO        String?
  TEMPS_PARTIEL     String?
  TEMPS_PARTIEL_L   String?
  ID_AGENT          String?
  ID_AGENT_ABS      String?
  DG_CAB            String?
  DG_CAB_L          String?

  @@map("BRUT_RH")
}

model BrutHierarchie {
  id              Int     @id @default(autoincrement())
  code_affect     String?
  nom_affect_l    String?
  code_secteur    String?
  nom_secteur_l   String?
  code_service    String?
  nom_service_l   String?
  code_direction  String?
  nom_direction_l String?
  code_dg_cab     String?
  nom_dg_cab_l    String?
  type_structure  String?
  responsable_nom String?
  responsable_id  String?

  @@map("BRUT_HIERARCHIE")
}

model BrutAd {
  id                 Int      @id @default(autoincrement())
  sam_account        String?
  distinguished_name String?
  display_name       String?
  given_name         String?
  surname            String?
  mail               String?
  enabled            Boolean?
  last_logon         String?
  member_of          String?
  title              String?
  department         String?
  company            String?
  manager            String?
  office             String?
  telephone          String?
  mobile             String?
  matricule_ad       String?
  when_created       String?
  ext_attr1          String?
  ext_attr2          String?
  ext_attr3          String?
  employee_id        String?

  @@map("BRUT_AD")
}

model BrutAzure {
  id                  Int      @id @default(autoincrement())
  user_principal_name String?
  display_name        String?
  given_name          String?
  surname             String?
  mail                String?
  account_enabled     Boolean?
  licenses            String?
  azure_id            String?
  job_title           String?
  department          String?
  office_location     String?
  company_name        String?
  created_at_azure    String?
  usage_location      String?
  mobile_phone        String?

  @@map("BRUT_AZURE")
}

model RefAgent {
  id                 Int          @id @default(autoincrement())
  matricule          String?      @unique
  nom                String
  prenom             String
  position_l         String?
  code_affect        String?
  nom_affect_l       String?
  code_service       String?
  nom_service        String?
  code_direction     String?
  nom_direction      String?
  code_dg_cab        String?
  nom_dg_cab_l       String?
  date_arrivee       DateTime?
  // Vraie premiere arrivee de l'agent dans la collectivite : renseignee une
  // seule fois a la creation de la fiche, jamais reecrite ensuite (contrairement
  // a date_arrivee qui reflete le debut du contrat/poste courant et est
  // ecrasee a chaque synchro Oracle - ex. renouvellement de contrat).
  date_premiere_arrivee DateTime?
  date_depart        DateTime?
  plus_vu            DateTime?
  ad_id              String?
  azure_id           String?
  actif              Boolean      @default(true)
  niveau_hierarchie  String?      @default("agent")
  licence            String?
  mail               String?
  mobile             String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
  fonction_l         String?
  poste_l            String?
  onboardingManagers Onboarding[]    @relation("OnboardingManager")
  onboardingAgents   Onboarding[]    @relation("OnboardingAgent")
  extra_ad_links     ExtraAdLink[]   @relation("ExtraAdLinks")

  @@map("REF_AGENTS")
}


model RefHierarchie {
  id              Int       @id @default(autoincrement())
  code_affect     String?
  nom_affect_l    String?
  code_secteur    String?
  nom_secteur_l   String?
  code_service    String?
  nom_service_l   String?
  code_direction  String?
  nom_direction_l String?
  code_dg_cab     String?
  nom_dg_cab_l    String?
  couleur         String?
  icone           String?
  responsable_sql String?
  plus_vu         DateTime?

  @@map("REF_HIERARCHIE")
}

model HierarchyLevel {
  id              Int      @id @default(autoincrement())
  level           Int      @unique
  name            String
  color           String?
  responsable_sql String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("HIERARCHY_LEVELS")
}

model Onboarding {
  id                  Int              @id @default(autoincrement())
  agent_id            Int?
  nom_temp            String?
  prenom_temp         String?
  manager_id          Int?
  statut              String           @default("a_faire")
  token_formulaire    String?          @unique
  token_dashboard     String?          @unique
  formulaire          String?
  reponses_formulaire String?
  date_arrivee_prevue DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  direction_temp      String?
  poste_temp          String?
  service_temp        String?
  manager             RefAgent?        @relation("OnboardingManager", fields: [manager_id], references: [id])
  agent               RefAgent?        @relation("OnboardingAgent", fields: [agent_id], references: [id])
  tasks               OnboardingTask[]

  @@map("ONBOARDING")
}

model OnboardingTask {
  id               Int        @id @default(autoincrement())
  onboarding_id    Int
  titre            String
  done             Boolean    @default(false)
  responsable_mail String?
  delay_days       Int        @default(0)
  task_token       String?    @unique
  date_completion  DateTime?
  commentaire      String?
  onboarding       Onboarding @relation(fields: [onboarding_id], references: [id], onDelete: Cascade)

  @@map("ONBOARDING_TASKS")
}

model SynchroLog {
  id         Int      @id @default(autoincrement())
  type       String
  statut     String
  message    String?
  details    String?
  progress   Int?     @default(0)
  created_at DateTime @default(now())
  agent_logs SyncAgentLog[]

  @@map("SYNCHRO_LOGS")
}

model SyncAgentLog {
  id         Int      @id @default(autoincrement())
  synchro_id Int
  matricule  String
  agent_nom  String?
  field      String
  old_value  String?
  new_value  String?
  created_at DateTime @default(now())
  synchro    SynchroLog @relation(fields: [synchro_id], references: [id], onDelete: Cascade)

  @@map("SYNC_AGENT_LOGS")
}

model Audit {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String
  target     String?
  details    String?
  created_at DateTime @default(now())

  @@map("AUDITS")
}

model EmailLog {
  id            Int      @id @default(autoincrement())
  to            String
  subject       String
  body          String
  sent_at       DateTime @default(now())
  status        String
  error         String?
  onboarding_id Int?

  @@map("EMAIL_LOGS")
}

model SmsLog {
  id            Int      @id @default(autoincrement())
  to            String
  message       String
  sent_at       DateTime @default(now())
  status        String
  error         String?
  onboarding_id Int?

  @@map("SMS_LOGS")
}


model ExtraAdLink {
  id          Int      @id @default(autoincrement())
  agent_id    Int
  sam_account String   @unique
  created_at  DateTime @default(now())
  agent       RefAgent @relation("ExtraAdLinks", fields: [agent_id], references: [id])

  @@map("EXTRA_AD_LINKS")
}


model AdExclusion {
  id          Int      @id @default(autoincrement())
  sam_account String   @unique
  reason      String?
  created_at  DateTime @default(now())

  @@map("AD_EXCLUSIONS")
}
