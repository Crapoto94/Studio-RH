generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/local-client"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

model Parametre {
  id     Int    @id @default(autoincrement())
  cle    String @unique
  valeur String

  @@map("PARAMETRES")
}

model AppRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions String   @default("[]")
  created_at  DateTime @default(now())

  @@map("ROLES")
}

model AppUser {
  id         Int      @id @default(autoincrement())
  login      String   @unique
  password   String
  nom        String
  prenom     String
  role       String   @default("user")
  is_ad      Boolean  @default(false)
  actif      Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("USERS")
}

model CronJob {
  id            Int       @id @default(autoincrement())
  name          String
  type          String // 'rh', 'ad', 'azure', 'brut', 'mairie'
  schedule      String // ex: "0 2 * * *" or "hourly"
  schedule_type String // 'daily', 'hourly', 'every_x_hours', 'custom' 
  sort_order    Int       @default(0)
  is_active     Boolean   @default(true)
  last_run      DateTime?
  next_run      DateTime? // Calculé ou stocké pour info
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("CRON_JOBS")
}

model Alignment {
  id                Int      @id @default(autoincrement())
  name              String
  field_rh          String
  field_ad          String
  is_case_sensitive Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("ALIGNMENTS")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  key_hash    String    @unique
  key_prefix  String
  permissions String    @default("read") // 'read' | 'read_write'
  expires_at  DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  created_by  String

  @@map("API_KEYS")
}
